[Unit]
Description=Harvest Post - Blog Article Processing via Local LLM
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=siroo
WorkingDirectory=/home/siroo/harvest_post
ExecStart=/home/siroo/harvest_post/run.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=5400
TimeoutStopSec=60

# Secrets are fetched from Doppler before each run.
# Non-secret config that Doppler doesn't manage:
Environment=QDRANT_PROD_PORT=6333
Environment=QDRANT_DEV_PORT=6335
Environment=PATH=/home/siroo/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/bin/bash -c '/home/siroo/.local/bin/doppler secrets download --project harvest_post --config prd --format env --no-file > /home/siroo/harvest_post/.env.doppler.tmp && mv /home/siroo/harvest_post/.env.doppler.tmp /home/siroo/harvest_post/.env.doppler'
EnvironmentFile=/home/siroo/harvest_post/.env.doppler

[Install]
WantedBy=multi-user.target
